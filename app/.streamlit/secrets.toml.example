# Copy this file to secrets.toml and fill in your real database URL.
# Do NOT commit secrets.toml to git -- only this .example file.
#
# For a local Postgres install (peer/socket auth, same as your OS user):
# DATABASE_URL = "postgresql+psycopg2:///ordflo_analytics"
#
# For a local Postgres with a password over TCP:
# DATABASE_URL = "postgresql+psycopg2://user:password@localhost:5432/ordflo_analytics"
#
# For a free hosted Postgres (Neon, Supabase, etc.) when deploying to Streamlit Cloud:
# DATABASE_URL = "postgresql+psycopg2://user:password@host/dbname?sslmode=require"
